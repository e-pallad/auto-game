{
  "name": "floeline",
  "version": "1.0.0",
  "private": true,
  "description": "Floeline - a daily sliding-ice puzzle where every place you stop melts behind you.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "bench": "node --experimental-strip-types scripts/bench-generator.ts",
    "package:itch": "node scripts/package-itch.mjs",
    "check": "npm run typecheck && npm run test && npm run test:e2e",
    "bench:browser": "node --experimental-strip-types scripts/bench-browser.ts",
    "review": "bash scripts/review.sh staged",
    "review:branch": "bash scripts/review.sh branch",
    "review:full": "bash scripts/review.sh branch --full",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
